# --- Application ---
# On the VM use APP_ENV=production, COOKIE_SECURE=true, and a real FRONTEND_URL.
APP_ENV=development
APP_NAME=Mail Campaign API
SECRET_KEY=replace-with-a-long-random-string-at-least-64-chars
ENCRYPTION_KEY=replace-with-fernet-key-see-notes
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://mailapp:mailapp@localhost:5432/mailapp
DATABASE_SYNC_URL=postgresql://mailapp:mailapp@localhost:5432/mailapp

# --- Redis / Celery ---
# The production Docker image starts Redis inside the same container.
# Leave these as localhost. Do not install Redis on the VM.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Auth cookies ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_MINUTES=43200
REFRESH_TOKEN_DAYS=30
# Public HTTPS origin Gmail can reach for open/click pixels. Required for inbox tracking.
TRACKING_PUBLIC_URL=

# --- OpenAI (optional until AI features are used) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Limits ---
MAX_CSV_BYTES=20971520
GLOBAL_HOURLY_SEND_LIMIT=5000

# --- Hosted assets + analytics ---
ASSET_STORAGE_DIR=storage/assets
MAX_ASSET_BYTES=10485760
ALLOWED_ASSET_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf
# Optional; defaults to SECRET_KEY. Used to salt hashed request IPs (raw IPs are never stored).
TRACKING_IP_HASH_SECRET=
TRACKING_REQUEST_RETENTION_DAYS=90
OPEN_AUTOMATED_WINDOW_SECONDS=30

# Azure Blob Storage (when set, uploads go to Azure instead of local disk)
# Quote the connection string — it contains '=' characters.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=mindsurvey
